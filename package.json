{
  "name": "founder-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:ingestion",
    "test:unit": "node --experimental-strip-types --test tests/events.test.mjs",
    "test:ingestion": "node --conditions=react-server --experimental-strip-types --test tests/ingestion/*.test.mjs",
    "ingest": "node --conditions=react-server --experimental-strip-types scripts/ingest.ts",
    "test:next": "node --test tests/next-html.test.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:migrate": "supabase migration up --local",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:test:isolated": "node --test tests/database/*.test.mjs",
    "db:lint": "supabase db lint --local --schema public --level warning --fail-on error",
    "db:types": "supabase gen types typescript --local",
    "format": "prettier --write app components lib scripts tests docs README.md"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "openai": "7.8.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
